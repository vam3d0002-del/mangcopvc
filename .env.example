# ==============================================================================
# CẤU HÌNH DỰ ÁN MÀNG CO PVC (VERCEL FREE + SUPABASE FREE)
# ==============================================================================

# 1. URL Website thực tế khi đưa lên Vercel (Dùng cho Sitemap, Robots.txt, Canonical SEO)
NEXT_PUBLIC_SITE_URL=https://mangcopvc.vercel.app

# 2. Thông tin kết nối Supabase (Lấy trong Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Mật khẩu đăng nhập trang Quản trị viên (/admin)
ADMIN_PASSWORD=admin123

# 4. Mã bí mật bảo vệ API Keep-Alive (/api/keep-alive?key=...)
CRON_SECRET=keep-alive-secret-2026
